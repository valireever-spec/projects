Dialogue: 1,0:00:00.00,0:00:02.00,HookCard,,0,0,0,,~14.000 DE MEDICI AU PLECAT\NDIN ROMÂNIA ÎN ȘASE ANI
Dialogue: 0,0:00:00.00,0:00:53.04,Header,,0,0,0,,SUB RADAR
Dialogue: 0,0:00:00.00,0:00:53.04,Source,,0,0,0,,OECD / World Bank — migrația medicilor
Dialogue: 0,0:00:02.00,0:00:02.99,Caption,,0,0,0,,ȘI DOUĂ MII CINCISPREZECE
Dialogue: 0,0:00:02.99,0:00:04.59,Caption,,0,0,0,,APROXIMATIV PAISPREZECE MII DE MEDICI
Dialogue: 0,0:00:04.59,0:00:06.20,Caption,,0,0,0,,AU PLECAT DIN ROMÂNIA CA
Dialogue: 0,0:00:06.20,0:00:07.75,Caption,,0,0,0,,SĂ LUCREZE ÎN ALTE ȚĂRI
Dialogue: 0,0:00:07.75,0:00:09.71,Caption,,0,0,0,,NU E O IMPRESIE 
Dialogue: 0,0:00:09.71,0:00:11.68,Caption,,0,0,0,,O ARATĂ DATELE OFICIALE ȘI
Dialogue: 0,0:00:11.68,0:00:13.25,Caption,,0,0,0,,ESTIMĂRILE DIN SISTEMUL SANITAR
Dialogue: 0,0:00:13.25,0:00:15.28,Caption,,0,0,0,,STATUL A PLĂTIT FORMAREA LOR
Dialogue: 0,0:00:15.28,0:00:16.98,Caption,,0,0,0,,ANI DE FACULTATE ȘI DE
Dialogue: 0,0:00:16.98,0:00:17.66,Caption,,0,0,0,,REZIDENȚIAT 
Dialogue: 0,0:00:17.66,0:00:19.35,Caption,,0,0,0,,ȘI APOI I-A PIERDUT ÎN
Dialogue: 0,0:00:19.35,0:00:21.05,Caption,,0,0,0,,FAVOAREA ALTOR SISTEME DE SĂNĂTATE
Dialogue: 0,0:00:21.05,0:00:22.76,Caption,,0,0,0,,SE ESTIMEAZĂ CĂ APROAPE UN
Dialogue: 0,0:00:22.76,0:00:24.48,Caption,,0,0,0,,SFERT DINTRE MEDICII FORMAȚI ÎN
Dialogue: 0,0:00:24.48,0:00:26.19,Caption,,0,0,0,,ROMÂNIA AU AJUNS SĂ LUCREZE
Dialogue: 0,0:00:26.19,0:00:26.88,Caption,,0,0,0,,ÎN STRĂINĂTATE
Dialogue: 0,0:00:26.88,0:00:28.56,Caption,,0,0,0,,REZULTATUL SE VEDE ÎN SPITALE
Dialogue: 0,0:00:28.56,0:00:30.25,Caption,,0,0,0,,SECȚII FĂRĂ PERSONAL SUFICIENT ȘI
Dialogue: 0,0:00:30.25,0:00:31.93,Caption,,0,0,0,,MAI ALES LA SATE ȘI
Dialogue: 0,0:00:31.93,0:00:32.94,Caption,,0,0,0,,ÎN ORAȘELE MICI
Dialogue: 0,0:00:32.94,0:00:34.63,Caption,,0,0,0,,OAMENI CARE FAC ZECI DE
Dialogue: 0,0:00:34.63,0:00:36.31,Caption,,0,0,0,,KILOMETRI PÂNĂ LA CEL MAI
Dialogue: 0,0:00:36.31,0:00:36.99,Caption,,0,0,0,,APROPIAT MEDIC
Dialogue: 0,0:00:36.99,0:00:39.13,Caption,,0,0,0,,S-A SCRIS DESPRE ASTA PERIODIC
Dialogue: 0,0:00:39.13,0:00:41.28,Caption,,0,0,0,,APOI SUBIECTUL A IEȘIT DIN
Dialogue: 0,0:00:41.28,0:00:42.14,Caption,,0,0,0,,ATENȚIA PUBLICĂ
Dialogue: 0,0:00:42.14,0:00:44.05,Caption,,0,0,0,,DAR CONTEAZĂ
Dialogue: 0,0:00:44.05,0:00:46.47,Caption,,0,0,0,,LIPSA MEDICILOR ÎNSEAMNĂ DIAGNOSTICE ÎNTÂRZIATE
Dialogue: 0,0:00:46.47,0:00:48.89,Caption,,0,0,0,,ȘI VIEȚI PUSE ÎN PERICOL
Dialogue: 0,0:00:48.89,0:00:50.93,Caption,,0,0,0,,URMĂREȘTE SUB RADAR PENTRU MAI
Dialogue: 0,0:00:50.93,0:00:52.98,Caption,,0,0,0,,MULTE POVEȘTI TRECUTE CU VEDEREA
Dialogue: 1,0:00:49.04,0:00:53.04,EndCard,,0,0,0,,SUB RADAR\NȘtiai asta? Spune-ne în comentarii ↓
