Dialogue: 1,0:00:00.00,0:00:02.00,HookCard,,0,0,0,,~14.000 DE MEDICI AU PLECAT\NDIN ROMÂNIA ÎN ȘASE ANI
Dialogue: 0,0:00:00.00,0:00:50.14,Header,,0,0,0,,SUB RADAR
Dialogue: 0,0:00:00.00,0:00:50.14,Source,,0,0,0,,OECD / World Bank — migrația medicilor
Dialogue: 0,0:00:02.00,0:00:02.94,Caption,,0,0,0,,DOUĂ MII CINCISPREZECE
Dialogue: 0,0:00:02.94,0:00:04.72,Caption,,0,0,0,,APROXIMATIV PAISPREZECE MII DE MEDICI
Dialogue: 0,0:00:04.72,0:00:06.49,Caption,,0,0,0,,AU PLECAT DIN ROMÂNIA PENTRU
Dialogue: 0,0:00:06.49,0:00:08.22,Caption,,0,0,0,,A PROFESA ÎN ALTE ȚĂRI
Dialogue: 0,0:00:08.22,0:00:10.79,Caption,,0,0,0,,CIFRELE PROVIN DIN DATELE OFICIALE
Dialogue: 0,0:00:10.79,0:00:13.37,Caption,,0,0,0,,ȘI DIN ESTIMĂRILE SISTEMULUI SANITAR
Dialogue: 0,0:00:13.37,0:00:15.30,Caption,,0,0,0,,STATUL A FINANȚAT FORMAREA ACESTORA
Dialogue: 0,0:00:15.30,0:00:17.23,Caption,,0,0,0,,— ANI DE FACULTATE ȘI
Dialogue: 0,0:00:17.23,0:00:18.39,Caption,,0,0,0,,DE REZIDENȚIAT 
Dialogue: 0,0:00:18.39,0:00:20.32,Caption,,0,0,0,,DUPĂ CARE I-A PIERDUT ÎN
Dialogue: 0,0:00:20.32,0:00:22.25,Caption,,0,0,0,,FAVOAREA ALTOR SISTEME DE SĂNĂTATE
Dialogue: 0,0:00:22.25,0:00:24.12,Caption,,0,0,0,,SE ESTIMEAZĂ CĂ APROAPE UN
Dialogue: 0,0:00:24.12,0:00:25.98,Caption,,0,0,0,,SFERT DINTRE MEDICII FORMAȚI ÎN
Dialogue: 0,0:00:25.98,0:00:27.84,Caption,,0,0,0,,ROMÂNIA AU AJUNS SĂ LUCREZE
Dialogue: 0,0:00:27.84,0:00:28.59,Caption,,0,0,0,,ÎN STRĂINĂTATE
Dialogue: 0,0:00:28.59,0:00:30.44,Caption,,0,0,0,,EFECTELE SE RESIMT ÎN SPITALE
Dialogue: 0,0:00:30.44,0:00:32.29,Caption,,0,0,0,,SECȚII CU PERSONAL INSUFICIENT ȘI
Dialogue: 0,0:00:32.29,0:00:34.14,Caption,,0,0,0,,MAI ALES ÎN MEDIUL RURAL
Dialogue: 0,0:00:34.14,0:00:35.62,Caption,,0,0,0,,ȘI ÎN ORAȘELE MICI
Dialogue: 0,0:00:35.62,0:00:37.47,Caption,,0,0,0,,PACIENȚI NEVOIȚI SĂ PARCURGĂ ZECI
Dialogue: 0,0:00:37.47,0:00:39.32,Caption,,0,0,0,,DE KILOMETRI PÂNĂ LA CEL
Dialogue: 0,0:00:39.32,0:00:40.43,Caption,,0,0,0,,MAI APROPIAT MEDIC
Dialogue: 0,0:00:40.43,0:00:43.04,Caption,,0,0,0,,LIPSA MEDICILOR ÎNSEAMNĂ DIAGNOSTICE ÎNTÂRZIATE
Dialogue: 0,0:00:43.04,0:00:45.65,Caption,,0,0,0,,ȘI VIEȚI PUSE ÎN PERICOL
Dialogue: 0,0:00:45.65,0:00:47.87,Caption,,0,0,0,,URMĂREȘTE SUB RADAR PENTRU MAI
Dialogue: 0,0:00:47.87,0:00:50.08,Caption,,0,0,0,,MULTE POVEȘTI TRECUTE CU VEDEREA
Dialogue: 1,0:00:46.14,0:00:50.14,EndCard,,0,0,0,,SUB RADAR\NȘtiai asta? Spune-ne în comentarii ↓
