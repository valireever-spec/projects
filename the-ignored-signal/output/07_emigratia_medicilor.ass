Dialogue: 1,0:00:00.00,0:00:02.00,HookCard,,0,0,0,,~14.000 DE MEDICI AU PLECAT\NDIN ROMÂNIA ÎN ȘASE ANI
Dialogue: 0,0:00:00.00,0:00:57.65,Header,,0,0,0,,SUB RADAR
Dialogue: 0,0:00:00.00,0:00:57.65,Source,,0,0,0,,OECD / World Bank — migrația medicilor
Dialogue: 0,0:00:02.00,0:00:03.24,Caption,,0,0,0,,ȘI DOUĂ MII CINCISPREZECE
Dialogue: 0,0:00:03.24,0:00:04.98,Caption,,0,0,0,,APROXIMATIV PAISPREZECE MII DE MEDICI
Dialogue: 0,0:00:04.98,0:00:06.73,Caption,,0,0,0,,AU PLECAT DIN ROMÂNIA CA
Dialogue: 0,0:00:06.73,0:00:08.42,Caption,,0,0,0,,SĂ LUCREZE ÎN ALTE ȚĂRI
Dialogue: 0,0:00:08.42,0:00:10.56,Caption,,0,0,0,,NU E O IMPRESIE 
Dialogue: 0,0:00:10.56,0:00:12.69,Caption,,0,0,0,,O ARATĂ DATELE OFICIALE ȘI
Dialogue: 0,0:00:12.69,0:00:14.40,Caption,,0,0,0,,ESTIMĂRILE DIN SISTEMUL SANITAR
Dialogue: 0,0:00:14.40,0:00:16.25,Caption,,0,0,0,,STATUL A PLĂTIT FORMAREA LOR
Dialogue: 0,0:00:16.25,0:00:18.09,Caption,,0,0,0,,— ANI DE FACULTATE ȘI
Dialogue: 0,0:00:18.09,0:00:19.19,Caption,,0,0,0,,DE REZIDENȚIAT 
Dialogue: 0,0:00:19.19,0:00:21.04,Caption,,0,0,0,,ȘI APOI I-A PIERDUT ÎN
Dialogue: 0,0:00:21.04,0:00:22.88,Caption,,0,0,0,,FAVOAREA ALTOR SISTEME DE SĂNĂTATE
Dialogue: 0,0:00:22.88,0:00:24.74,Caption,,0,0,0,,SE ESTIMEAZĂ CĂ APROAPE UN
Dialogue: 0,0:00:24.74,0:00:26.60,Caption,,0,0,0,,SFERT DINTRE MEDICII FORMAȚI ÎN
Dialogue: 0,0:00:26.60,0:00:28.47,Caption,,0,0,0,,ROMÂNIA AU AJUNS SĂ LUCREZE
Dialogue: 0,0:00:28.47,0:00:29.21,Caption,,0,0,0,,ÎN STRĂINĂTATE
Dialogue: 0,0:00:29.21,0:00:31.04,Caption,,0,0,0,,REZULTATUL SE VEDE ÎN SPITALE
Dialogue: 0,0:00:31.04,0:00:32.88,Caption,,0,0,0,,SECȚII FĂRĂ PERSONAL SUFICIENT ȘI
Dialogue: 0,0:00:32.88,0:00:34.71,Caption,,0,0,0,,MAI ALES LA SATE ȘI
Dialogue: 0,0:00:34.71,0:00:35.81,Caption,,0,0,0,,ÎN ORAȘELE MICI
Dialogue: 0,0:00:35.81,0:00:37.64,Caption,,0,0,0,,OAMENI CARE FAC ZECI DE
Dialogue: 0,0:00:37.64,0:00:39.47,Caption,,0,0,0,,KILOMETRI PÂNĂ LA CEL MAI
Dialogue: 0,0:00:39.47,0:00:40.20,Caption,,0,0,0,,APROPIAT MEDIC
Dialogue: 0,0:00:40.20,0:00:42.54,Caption,,0,0,0,,S-A SCRIS DESPRE ASTA PERIODIC
Dialogue: 0,0:00:42.54,0:00:44.87,Caption,,0,0,0,,APOI SUBIECTUL A IEȘIT DIN
Dialogue: 0,0:00:44.87,0:00:45.80,Caption,,0,0,0,,ATENȚIA PUBLICĂ
Dialogue: 0,0:00:45.80,0:00:47.88,Caption,,0,0,0,,DAR CONTEAZĂ
Dialogue: 0,0:00:47.88,0:00:50.51,Caption,,0,0,0,,LIPSA MEDICILOR ÎNSEAMNĂ DIAGNOSTICE ÎNTÂRZIATE
Dialogue: 0,0:00:50.51,0:00:53.14,Caption,,0,0,0,,ȘI VIEȚI PUSE ÎN PERICOL
Dialogue: 0,0:00:53.14,0:00:55.36,Caption,,0,0,0,,URMĂREȘTE SUB RADAR PENTRU MAI
Dialogue: 0,0:00:55.36,0:00:57.58,Caption,,0,0,0,,MULTE POVEȘTI TRECUTE CU VEDEREA
Dialogue: 1,0:00:53.65,0:00:57.65,EndCard,,0,0,0,,SUB RADAR\NȘtiai asta? Spune-ne în comentarii ↓
