Dialogue: 0,0:00:02.00,0:00:03.69,Caption,,0,0,0,,ROMÂNIA SE AFLĂ LA RISC
Dialogue: 0,0:00:03.69,0:00:05.80,Caption,,0,0,0,,DE SĂRĂCIE SAU DE EXCLUZIUNE SOCIALĂ
Dialogue: 0,0:00:05.80,0:00:07.68,Caption,,0,0,0,,POTRIVIT DATELOR EUROSTAT PENTRU ANUL
Dialogue: 0,0:00:07.68,0:00:09.56,Caption,,0,0,0,,DOUĂ MII DOUĂZECI ȘI PATRU
Dialogue: 0,0:00:09.56,0:00:11.44,Caption,,0,0,0,,ESTE VORBA DESPRE APROXIMATIV UN
Dialogue: 0,0:00:11.44,0:00:13.31,Caption,,0,0,0,,MILION DOUĂ SUTE CINCIZECI DE
Dialogue: 0,0:00:13.31,0:00:14.44,Caption,,0,0,0,,MII DE COPII
Dialogue: 0,0:00:14.44,0:00:16.26,Caption,,0,0,0,,RATA, DE PESTE TREIZECI ȘI
