Dialogue: 1,0:00:00.00,0:00:02.00,HookCard,,0,0,0,,PESTE 3 MILIOANE DE ROMÂNI\NAU PLECAT DE LA ADERAREA LA UE
Dialogue: 0,0:00:00.00,0:00:58.58,Header,,0,0,0,,SUB RADAR
Dialogue: 0,0:00:00.00,0:00:58.58,Source,,0,0,0,,Eurostat / OECD
Dialogue: 0,0:00:02.00,0:00:03.86,Caption,,0,0,0,,EUROPEANĂ, ÎN DOUĂ MII ȘAPTE
Dialogue: 0,0:00:03.86,0:00:05.75,Caption,,0,0,0,,PESTE TREI MILIOANE DE ROMÂNI
Dialogue: 0,0:00:05.75,0:00:07.20,Caption,,0,0,0,,AU PLECAT DIN ȚARĂ
Dialogue: 0,0:00:07.20,0:00:09.35,Caption,,0,0,0,,NU E O ESTIMARE ARUNCATĂ
Dialogue: 0,0:00:09.35,0:00:10.64,Caption,,0,0,0,,LA ÎNTÂMPLARE 
Dialogue: 0,0:00:10.64,0:00:12.79,Caption,,0,0,0,,O ARATĂ DATELE EUROSTAT ȘI
Dialogue: 0,0:00:12.79,0:00:13.65,Caption,,0,0,0,,ALE OECD
Dialogue: 0,0:00:13.65,0:00:17.36,Caption,,0,0,0,,ÎNSEAMNĂ APROAPE UNUL DIN ȘASE LOCUITORI
Dialogue: 0,0:00:17.36,0:00:19.26,Caption,,0,0,0,,POPULAȚIA A SCĂZUT DE LA
Dialogue: 0,0:00:19.26,0:00:21.16,Caption,,0,0,0,,PESTE DOUĂZECI ȘI DOUĂ DE
Dialogue: 0,0:00:21.16,0:00:23.06,Caption,,0,0,0,,MILIOANE, ÎN ANUL DOUĂ MII
Dialogue: 0,0:00:23.06,0:00:24.95,Caption,,0,0,0,,SPRE NOUĂSPREZECE MILIOANE ȘI JUMĂTATE
Dialogue: 0,0:00:24.95,0:00:26.85,Caption,,0,0,0,,— IAR PLECĂRILE AU PRODUS
Dialogue: 0,0:00:26.85,0:00:29.13,Caption,,0,0,0,,PESTE TREI SFERTURI DIN ACEASTĂ SCĂDERE
Dialogue: 0,0:00:29.13,0:00:30.86,Caption,,0,0,0,,LA ASTA SE ADAUGĂ FAPTUL
Dialogue: 0,0:00:30.86,0:00:32.59,Caption,,0,0,0,,CĂ MOR MAI MULȚI OAMENI
Dialogue: 0,0:00:32.59,0:00:33.63,Caption,,0,0,0,,DECÂT SE NASC
Dialogue: 0,0:00:33.63,0:00:35.58,Caption,,0,0,0,,REZULTATUL E UNA DINTRE CELE
Dialogue: 0,0:00:35.58,0:00:37.54,Caption,,0,0,0,,MAI RAPIDE SCĂDERI DE POPULAȚIE
Dialogue: 0,0:00:37.54,0:00:38.33,Caption,,0,0,0,,DIN EUROPA
Dialogue: 0,0:00:38.33,0:00:39.89,Caption,,0,0,0,,PE TIMP DE PACE
Dialogue: 0,0:00:39.89,0:00:42.26,Caption,,0,0,0,,S-A SCRIS DESPRE ASTA PERIODIC
Dialogue: 0,0:00:42.26,0:00:44.64,Caption,,0,0,0,,APOI POVESTEA A DISPĂRUT DIN
Dialogue: 0,0:00:44.64,0:00:45.58,Caption,,0,0,0,,ATENȚIA PUBLICĂ
Dialogue: 0,0:00:45.58,0:00:47.63,Caption,,0,0,0,,DAR CONTEAZĂ
Dialogue: 0,0:00:47.63,0:00:49.79,Caption,,0,0,0,,MAI PUȚINI OAMENI ÎNSEAMNĂ SATE
Dialogue: 0,0:00:49.79,0:00:51.94,Caption,,0,0,0,,GOLITE, ȘCOLI ÎNCHISE ȘI TOT
Dialogue: 0,0:00:51.94,0:00:54.09,Caption,,0,0,0,,MAI PUȚINI CARE SUSȚIN PENSIILE
Dialogue: 0,0:00:54.09,0:00:56.31,Caption,,0,0,0,,URMĂREȘTE SUB RADAR PENTRU MAI
Dialogue: 0,0:00:56.31,0:00:58.53,Caption,,0,0,0,,MULTE POVEȘTI TRECUTE CU VEDEREA
Dialogue: 1,0:00:54.58,0:00:58.58,EndCard,,0,0,0,,SUB RADAR\NȘtiai asta? Spune-ne în comentarii ↓
