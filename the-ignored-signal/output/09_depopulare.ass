Dialogue: 1,0:00:00.00,0:00:02.00,HookCard,,0,0,0,,PESTE 3 MILIOANE DE ROMÂNI\NAU PLECAT DE LA ADERAREA LA UE
Dialogue: 0,0:00:00.00,0:01:02.00,Header,,0,0,0,,SUB RADAR
Dialogue: 0,0:00:00.00,0:01:02.00,Source,,0,0,0,,Eurostat / OECD
Dialogue: 0,0:00:02.00,0:00:02.18,Caption,,0,0,0,,EUROPEANĂ
Dialogue: 0,0:00:02.18,0:00:03.56,Caption,,0,0,0,,ÎN DOUĂ MII ȘAPTE
Dialogue: 0,0:00:03.56,0:00:05.29,Caption,,0,0,0,,PESTE TREI MILIOANE DE ROMÂNI
Dialogue: 0,0:00:05.29,0:00:06.62,Caption,,0,0,0,,AU PLECAT DIN ȚARĂ
Dialogue: 0,0:00:06.62,0:00:08.60,Caption,,0,0,0,,NU E O ESTIMARE ARUNCATĂ
Dialogue: 0,0:00:08.60,0:00:09.79,Caption,,0,0,0,,LA ÎNTÂMPLARE 
Dialogue: 0,0:00:09.79,0:00:11.77,Caption,,0,0,0,,O ARATĂ DATELE EUROSTAT ȘI
Dialogue: 0,0:00:11.77,0:00:12.56,Caption,,0,0,0,,ALE OECD
Dialogue: 0,0:00:12.56,0:00:15.41,Caption,,0,0,0,,ÎNSEAMNĂ APROAPE UNUL DIN ȘASE
Dialogue: 0,0:00:15.41,0:00:15.97,Caption,,0,0,0,,LOCUITORI
Dialogue: 0,0:00:15.97,0:00:17.72,Caption,,0,0,0,,POPULAȚIA A SCĂZUT DE LA
Dialogue: 0,0:00:17.72,0:00:19.47,Caption,,0,0,0,,PESTE DOUĂZECI ȘI DOUĂ DE
Dialogue: 0,0:00:19.47,0:00:19.82,Caption,,0,0,0,,MILIOANE
Dialogue: 0,0:00:19.82,0:00:21.21,Caption,,0,0,0,,ÎN ANUL DOUĂ MII
Dialogue: 0,0:00:21.21,0:00:23.31,Caption,,0,0,0,,SPRE NOUĂSPREZECE MILIOANE ȘI JUMĂTATE
Dialogue: 0,0:00:23.31,0:00:25.05,Caption,,0,0,0,,IAR PLECĂRILE AU PRODUS PESTE
Dialogue: 0,0:00:25.05,0:00:26.80,Caption,,0,0,0,,TREI SFERTURI DIN ACEASTĂ SCĂDERE
Dialogue: 0,0:00:26.80,0:00:28.39,Caption,,0,0,0,,LA ASTA SE ADAUGĂ FAPTUL
Dialogue: 0,0:00:28.39,0:00:29.98,Caption,,0,0,0,,CĂ MOR MAI MULȚI OAMENI
Dialogue: 0,0:00:29.98,0:00:30.94,Caption,,0,0,0,,DECÂT SE NASC
Dialogue: 0,0:00:30.94,0:00:32.74,Caption,,0,0,0,,REZULTATUL E UNA DINTRE CELE
Dialogue: 0,0:00:32.74,0:00:34.54,Caption,,0,0,0,,MAI RAPIDE SCĂDERI DE POPULAȚIE
Dialogue: 0,0:00:34.54,0:00:35.26,Caption,,0,0,0,,DIN EUROPA
Dialogue: 0,0:00:35.26,0:00:36.70,Caption,,0,0,0,,PE TIMP DE PACE
Dialogue: 0,0:00:36.70,0:00:38.88,Caption,,0,0,0,,S-A SCRIS DESPRE ASTA PERIODIC
Dialogue: 0,0:00:38.88,0:00:41.06,Caption,,0,0,0,,APOI POVESTEA A DISPĂRUT DIN
Dialogue: 0,0:00:41.06,0:00:41.94,Caption,,0,0,0,,ATENȚIA PUBLICĂ
Dialogue: 0,0:00:41.94,0:00:43.83,Caption,,0,0,0,,DAR CONTEAZĂ
Dialogue: 0,0:00:43.83,0:00:45.80,Caption,,0,0,0,,MAI PUȚINI OAMENI ÎNSEAMNĂ SATE
Dialogue: 0,0:00:45.80,0:00:46.19,Caption,,0,0,0,,GOLITE
Dialogue: 0,0:00:46.19,0:00:48.16,Caption,,0,0,0,,ȘCOLI ÎNCHISE ȘI TOT MAI
Dialogue: 0,0:00:48.16,0:00:49.74,Caption,,0,0,0,,PUȚINI CARE SUSȚIN PENSIILE
Dialogue: 0,0:00:49.74,0:00:51.99,Caption,,0,0,0,,SURSELE SUNT PE ECRAN
Dialogue: 0,0:00:51.99,0:00:54.33,Caption,,0,0,0,,URMĂREȘTE SUB RADAR PENTRU MAI
Dialogue: 0,0:00:54.33,0:00:55.74,Caption,,0,0,0,,MULTE SEMNALE IGNORATE
Dialogue: 1,0:00:55.80,0:01:02.00,EndCard,,0,0,0,,SUB RADAR\NȘtiai asta? Spune-ne în comentarii ↓
