Dialogue: 0,0:00:00.00,0:00:50.28,Source,,0,0,0,,Eurostat / OECD
Dialogue: 0,0:00:02.00,0:00:02.11,Caption,,0,0,0,,DE LA ADERAREA LA UNIUNEA
Dialogue: 0,0:00:02.11,0:00:04.11,Caption,,0,0,0,,EUROPEANĂ, ÎN DOUĂ MII ȘAPTE
Dialogue: 0,0:00:04.11,0:00:06.12,Caption,,0,0,0,,PESTE TREI MILIOANE DE ROMÂNI
Dialogue: 0,0:00:06.12,0:00:06.88,Caption,,0,0,0,,AU EMIGRAT
Dialogue: 0,0:00:06.88,0:00:09.16,Caption,,0,0,0,,CIFRELE PROVIN DIN DATELE EUROSTAT
Dialogue: 0,0:00:09.16,0:00:11.45,Caption,,0,0,0,,ȘI ALE OECD ȘI REPREZINTĂ
Dialogue: 0,0:00:11.45,0:00:13.74,Caption,,0,0,0,,APROAPE UNUL DIN ȘASE LOCUITORI
Dialogue: 0,0:00:13.74,0:00:15.79,Caption,,0,0,0,,POPULAȚIA A SCĂZUT DE LA
Dialogue: 0,0:00:15.79,0:00:17.85,Caption,,0,0,0,,PESTE DOUĂZECI ȘI DOUĂ DE
Dialogue: 0,0:00:17.85,0:00:19.90,Caption,,0,0,0,,MILIOANE, ÎN ANUL DOUĂ MII
Dialogue: 0,0:00:19.90,0:00:21.96,Caption,,0,0,0,,LA APROXIMATIV NOUĂSPREZECE MILIOANE ȘI
Dialogue: 0,0:00:21.96,0:00:24.01,Caption,,0,0,0,,JUMĂTATE, MIGRAȚIA FIIND RESPONSABILĂ PENTRU
Dialogue: 0,0:00:24.01,0:00:26.48,Caption,,0,0,0,,PESTE TREI SFERTURI DIN ACEASTĂ SCĂDERE
Dialogue: 0,0:00:26.48,0:00:28.95,Caption,,0,0,0,,LA ACEASTA SE ADAUGĂ UN
Dialogue: 0,0:00:28.95,0:00:30.92,Caption,,0,0,0,,SPOR NATURAL NEGATIV 
Dialogue: 0,0:00:30.92,0:00:32.40,Caption,,0,0,0,,DECESELE DEPĂȘESC NAȘTERILE
Dialogue: 0,0:00:32.40,0:00:34.26,Caption,,0,0,0,,REZULTATUL ESTE UNA DINTRE CELE
Dialogue: 0,0:00:34.26,0:00:36.12,Caption,,0,0,0,,MAI RAPIDE SCĂDERI DE POPULAȚIE
Dialogue: 0,0:00:36.12,0:00:38.35,Caption,,0,0,0,,DIN EUROPA PE TIMP DE PACE
Dialogue: 0,0:00:38.35,0:00:40.68,Caption,,0,0,0,,MAI PUȚINI LOCUITORI ÎNSEAMNĂ SATE
Dialogue: 0,0:00:40.68,0:00:43.00,Caption,,0,0,0,,DEPOPULATE, ȘCOLI ÎNCHISE ȘI TOT
Dialogue: 0,0:00:43.00,0:00:45.79,Caption,,0,0,0,,MAI PUȚINI CONTRIBUABILI CARE SUSȚIN PENSIILE
Dialogue: 0,0:00:45.79,0:00:48.01,Caption,,0,0,0,,URMĂREȘTE SUB RADAR PENTRU MAI
Dialogue: 0,0:00:48.01,0:00:50.23,Caption,,0,0,0,,MULTE POVEȘTI TRECUTE CU VEDEREA
